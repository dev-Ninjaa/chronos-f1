# Chronos F1 - Environment Configuration

# Local Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:2b

# Optional Langflow server
LANGFLOW_URL=http://localhost:7860
LANGFLOW_API_KEY=your_langflow_api_key_here

# Application settings
SECRET_KEY=chronos-f1-enhanced-key
HOST=0.0.0.0
PORT=5000
DEBUG=True

# FastF1 cache settings
FASTF1_CACHE_DIR=.fastf1-cache

# Notes
# 1. Ollama must be running locally at OLLAMA_BASE_URL.
# 2. The default model is granite3.3:2b.
# 3. AI commentary generates every 60 seconds during replay.
# 4. Workflow analysis runs every 15 seconds.
