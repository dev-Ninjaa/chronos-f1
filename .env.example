# Chronos F1 - Environment Configuration

# =============================================================================
# GOOGLE GEMINI API (Temporary - For Development)
# =============================================================================
# Get your free API key from: https://makersuite.google.com/app/apikey
# Free tier: 15 requests/min, 1M tokens/day - Perfect for development!
#
# NOTE: We are currently using Gemini for rapid prototyping and testing.
#       Before final publication, we will migrate to IBM Granite API.
#       The architecture is designed to be model-agnostic for easy switching.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# IBM AI TECHNOLOGIES STATUS
# =============================================================================
# ✅ Docling: INSTALLED - Works with built-in markdown processor
# ✅ Langflow: INSTALLED - Works with built-in workflow implementations
# 🚧 IBM Granite: COMING SOON - Will replace Gemini before publication
#
# Run 'python check_dependencies.py' to verify all packages are installed

# =============================================================================
# FUTURE: IBM GRANITE API (Coming Soon)
# =============================================================================
# Once we migrate to IBM Granite, uncomment and configure:
# GRANITE_API_KEY=your_ibm_granite_api_key_here
# GRANITE_MODEL=granite-3.0-8b-instruct
# GRANITE_API_URL=https://api.ibm.com/granite/v1

# =============================================================================
# OPTIONAL: LANGFLOW SERVER (Not required - workflows work without it)
# =============================================================================
# If you want to run the full Langflow server (optional):
# LANGFLOW_URL=http://localhost:7860
# LANGFLOW_API_KEY=your_langflow_api_key_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Flask secret key (change in production)
SECRET_KEY=chronos-f1-enhanced-key

# Server configuration
HOST=0.0.0.0
PORT=5000
DEBUG=True

# =============================================================================
# FASTF1 CACHE SETTINGS
# =============================================================================
# Cache directory for F1 data (relative to project root)
FASTF1_CACHE_DIR=.fastf1-cache

# =============================================================================
# NOTES
# =============================================================================
# 1. Only GEMINI_API_KEY is required for full functionality (for now)
# 2. Docling and Langflow are installed and work without external services
# 3. Run 'python check_dependencies.py' to verify installation
# 4. First race load takes 30-60s (downloads data), then instant (cached)
# 5. AI commentary generates every 90 seconds during replay
# 6. Workflow analysis runs every 15 seconds
# 7. Before publication: We will migrate from Gemini to IBM Granite
